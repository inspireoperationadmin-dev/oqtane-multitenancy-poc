@namespace OqtanePoc.Modules.ProductCatalog
@inherits ModuleBase
@inject IProductService ProductService

<div class="card shadow-sm p-4 mb-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="text-primary mb-0">Product Catalog (Tenant 1)</h4>
        <span class="badge bg-success">Isolated Database Active</span>
    </div>
    <p class="text-muted">Stored exclusively in Tenant 1's isolated database table (<code>ProductCatalog_Item</code>).</p>
    
    @if (_products == null)
    {
        <p><em>Loading products...</em></p>
    }
    else if (_products.Count == 0)
    {
        <div class="alert alert-info">No products found in this tenant database.</div>
    }
    else
    {
        <table class="table table-striped table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>SKU</th>
                    <th>Title</th>
                    <th>Price</th>
                    <th>Stock Quantity</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var product in _products)
                {
                    <tr>
                        <td><strong>@product.Sku</strong></td>
                        <td>@product.Title</td>
                        <td>@product.Price.ToString("C")</td>
                        <td>@product.StockQuantity</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    private List<ProductItem> _products;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _products = await ProductService.GetProductsAsync(ModuleState.ModuleId);
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error Loading Products {Error}", ex.Message);
            _products = new List<ProductItem>();
        }
    }
}
