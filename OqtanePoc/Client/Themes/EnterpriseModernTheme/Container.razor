@namespace OqtanePoc.Themes.EnterpriseModernTheme
@inherits ContainerBase

<div class="card shadow-sm border-0 mb-4 rounded-3 overflow-hidden">
    @if (ModuleState.Title != "-")
    {
        <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center">
            <h5 class="card-title mb-0 fw-semibold text-dark"><ModuleTitle /></h5>
            <div>
                <ModuleActions />
            </div>
        </div>
    }
    else
    {
        <div class="p-2 text-end">
            <ModuleActions />
        </div>
    }
    <div class="card-body">
        <ModuleInstance />
    </div>
</div>

@code {
    public override string Name => "Enterprise Modern Container";
}
